# GitHub OAuth Configuration
NEXT_PUBLIC_GITHUB_ID=your_github_app_id
GITHUB_SECRET=your_github_app_secret

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXTAUTH_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# GitHub Token for Write Access (optional)
GITHUB_WRITE_TOKEN=your_github_token_for_editing

# Application Settings
NEXT_PUBLIC_APP_NAME=Chemical Control System
NEXT_PUBLIC_ZDHC_LEVEL=ZDHC Gateway
NODE_ENV=development
